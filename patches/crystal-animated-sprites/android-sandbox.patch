 local BASE = mod.path .. "/assets"
 local SPRITE_BASE = BASE
 local SHINY_BASE = BASE .. "/shiny_visuals"
+
+-- Gen1Recomp 0.1.84+ runs mods in a sandbox where raw filesystem access is
+-- unavailable.  mod:read() is the supported way to read files shipped with
+-- this mod.  Most of this mod's rendering paths are full mod paths, so strip
+-- the mod root before handing them to mod:read().
+local MOD_PATH_PREFIX = mod.path .. "/"
+local function modRelativePath(path)
+  if type(path) ~= "string" then return nil end
+  if path:sub(1, #MOD_PATH_PREFIX) == MOD_PATH_PREFIX then
+    return path:sub(#MOD_PATH_PREFIX + 1)
+  end
+  return path
+end
+
+local function readModFile(path)
+  local relative = modRelativePath(path)
+  if not relative or relative == "" then return nil end
+  return mod:read(relative)
+end
+
+local fileExistsCache = {}
 
 
