+  -- Evolution.apply emits pokemon.evolved while EvolutionState is still on
+  -- the stack. Pushing an MMO level-up TextBox from that event inserts it
+  -- between EvolutionState and Gen1Recomp's own result TextBox, so the
+  -- engine later pops the wrong state and exposes the stale "is evolving"
+  -- screen. Defer only that notification until the evolution state is gone.
+  local function evolutionStateActive(game)
+    local states = game and game.stack and game.stack.states
+    if type(states) ~= "table" then return false end
+    for i = 1, #states do
+      if getmetatable(states[i]) == EvolutionState then
+        return true
+      end
+    end
+    return false
+  end
+
+  local function showMmoLevelUp(game, level)
+    if not game or not game.stack then return end
+    local Sound = require("src.core.Sound")
+    pcall(function() Sound.play(game.data, "Level_Up") end)
+    game.stack:push(TextBox.new(game,
+      wrapText(string.format("LEVEL UP!\nREACHED MMO LEVEL %d!", level))))
+  end
