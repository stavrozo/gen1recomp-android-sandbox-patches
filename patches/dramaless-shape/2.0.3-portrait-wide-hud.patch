diff --git a/lib/VoxelBattleHUD.lua b/lib/VoxelBattleHUD.lua
new file mode 100644
index 0000000..63c641c
--- /dev/null
+++ b/lib/VoxelBattleHUD.lua
@@ -0,0 +1,281 @@
+-- Portrait WIDE/FILL enemy-HUD placement for Dramaless voxel battles.
+--
+-- Keep Gen1Recomp's normal 304x144 WIDE HUD pipeline intact.  On a tall
+-- portrait display the width-limited FILL surface sits well below the top of
+-- the physical viewport, so its enemy panel at logical (0,0) overlaps the 3D
+-- opponent.  At final composition time, copy that already-rendered 128x32
+-- panel onto Dramaless's full-resolution world override just above the battle
+-- surface, then clear only the old panel rectangle from the UI canvas.
+--
+-- No detached-anchor compositor is used here; player HUD, message
+-- boxes and menus therefore remain byte-for-byte in their normal WIDE layout.
+
+local V = ...
+
+local HUD = {}
+local ENEMY_W, ENEMY_H = 128, 32
+local GAP = 8            -- native WIDE pixels between panel and battle surface
+local MIN_TOP = 8        -- keep at least this many native pixels from viewport top
+
+local panelCanvas
+local panelValid = false
+local cachedEnemy
+local installedEndFrame
+local activeRenderer
+
+local function boolMethod(obj, name)
+  local fn = obj and obj[name]
+  if type(fn) ~= "function" then return false end
+  local ok, value = pcall(fn, obj)
+  return ok and value and true or false
+end
+
+local function battleIsTopState(battle)
+  local stack = battle and battle.game and battle.game.stack
+  if not (stack and type(stack.top) == "function") then return true end
+  local ok, top = pcall(stack.top, stack)
+  return not ok or top == battle
+end
+
+local function enemyPanelVisible(battle)
+  if not (battle and battle.enemy) then return false end
+  if not battleIsTopState(battle) then return false end
+  if not boolMethod(battle, "statusHUDVisible") then return false end
+  if battle.showEnemyTrainer or battle.enemySendingOut or battle.introBalls
+      or battle.blankForAskName or battle.enemy.fainted then return false end
+  if tonumber(battle.introSlide or 0) ~= 0 then return false end
+
+  local grow = battle.growInScale
+  if type(grow) == "function" then
+    local ok, value = pcall(grow, battle, battle.enemy)
+    if ok and value ~= nil then return false end
+  end
+  return true
+end
+
+
+local function frameIsStable(battle)
+  if battle.animPlaying then return false end
+  local fx = battle.fx
+  if not fx then return true end
+  return tonumber(fx.shakeX or 0) == 0
+     and tonumber(fx.shakeY or 0) == 0
+     and tonumber(fx.shake or 0) <= 0
+     and tonumber(fx.flash or 0) <= 0
+end
+
+-- WideBattle.shaken() translates the native HUD by the same screen-shake
+-- offset used for the battlefield.  The detached enemy panel must ignore
+-- that motion, but the low copy still has to be erased where WideBattle
+-- actually drew it this frame.
+local function hudShakeOffset(battle)
+  local fx = battle and battle.fx
+  if not fx then return 0, 0 end
+  local sx = tonumber(fx.shakeX or 0) or 0
+  local sy = tonumber(fx.shakeY or 0) or 0
+  if sx == 0 and sy == 0 and (tonumber(fx.shake or 0) or 0) > 0 then
+    sx = ((tonumber(battle.frame or 0) or 0) % 4) < 2 and 2 or -2
+  end
+  return sx, sy
+end
+
+local function placement(renderer, battle)
+  if not (renderer and renderer.worldOverride and renderer.canvas) then return nil end
+  if not (boolMethod(battle, "isWideBattleLayout")
+      and boolMethod(battle, "wantsFillScale")
+      and enemyPanelVisible(battle)) then return nil end
+  if type(renderer.frameRects) ~= "function" then return nil end
+
+  local ok, r = pcall(renderer.frameRects, renderer)
+  if not (ok and type(r) == "table") then return nil end
+  local up = tonumber(r.Up) or 0
+  local dpiX, dpiY = tonumber(r.dpiX) or 1, tonumber(r.dpiY) or 1
+  local uox, uoy = tonumber(r.uox), tonumber(r.uoy)
+  local vuy = tonumber(r.vuy) or 0
+  if not (up > 0 and uox and uoy and dpiX > 0 and dpiY > 0) then return nil end
+
+  -- This compatibility case exists only when the centred WIDE/FILL surface
+  -- leaves enough real space above it for the complete panel plus a gap.
+  local battleTopPx = uoy * dpiY
+  local viewportTopPx = vuy * dpiY
+  local topPx = math.floor(battleTopPx - (ENEMY_H + GAP) * up + 0.5)
+  local minPx = viewportTopPx + MIN_TOP * up
+  if topPx < minPx then return nil end
+
+  local shakeX, shakeY = hudShakeOffset(battle)
+  return {
+    sourceX = 0, sourceY = 0,
+    clearX = shakeX, clearY = shakeY,
+    targetX = math.floor(uox * dpiX + 0.5),
+    targetY = topPx,
+    scale = up,
+  }
+end
+
+local function ensurePanelCanvas()
+  if panelCanvas and panelCanvas.getWidth and panelCanvas.getHeight
+      and panelCanvas:getWidth() == ENEMY_W
+      and panelCanvas:getHeight() == ENEMY_H then
+    return panelCanvas
+  end
+  if panelCanvas and panelCanvas.release then pcall(panelCanvas.release, panelCanvas) end
+  local ok, canvas = pcall(love.graphics.newCanvas,
+    ENEMY_W, ENEMY_H, { dpiscale = 1 })
+  if not (ok and canvas) then
+    panelCanvas = nil
+    return nil
+  end
+  if canvas.setFilter then canvas:setFilter("nearest", "nearest") end
+  panelCanvas = canvas
+  return canvas
+end
+
+local function saveGraphics(g)
+  local sx, sy, sw, sh
+  if g.getScissor then sx, sy, sw, sh = g.getScissor() end
+  local blend, alpha = "alpha", nil
+  if g.getBlendMode then blend, alpha = g.getBlendMode() end
+  local depth, write
+  if g.getDepthMode then depth, write = g.getDepthMode() end
+  return {
+    canvas = g.getCanvas and g.getCanvas() or nil,
+    shader = g.getShader and g.getShader() or nil,
+    blend = blend, alpha = alpha,
+    depth = depth, write = write,
+    color = g.getColor and { g.getColor() } or { 1, 1, 1, 1 },
+    scissor = sx ~= nil and { sx, sy, sw, sh } or false,
+  }
+end
+
+local function restoreGraphics(g, s)
+  if g.setCanvas then g.setCanvas(s.canvas) end
+  if g.setShader then g.setShader(s.shader) end
+  if g.setDepthMode then
+    if s.depth then g.setDepthMode(s.depth, s.write) else g.setDepthMode() end
+  end
+  if g.setBlendMode then g.setBlendMode(s.blend or "alpha", s.alpha) end
+  if g.setColor then g.setColor(unpack(s.color)) end
+  if g.setScissor then
+    if s.scissor then g.setScissor(unpack(s.scissor)) else g.setScissor() end
+  end
+end
+
+local function relocate(renderer, battle)
+  local p = placement(renderer, battle)
+  if not p then return false end
+  local world = renderer.worldOverride
+  local ui = renderer.canvas
+  if not (world and ui) then return false end
+  local panel = ensurePanelCanvas()
+  if not panel then return false end
+
+  local stable = frameIsStable(battle)
+  -- Never show a cached panel from the previous opponent/battle.
+  if not stable and (not panelValid or cachedEnemy ~= battle.enemy) then
+    return false
+  end
+
+  local g = love.graphics
+  local saved = saveGraphics(g)
+  local ok, err = pcall(function()
+    if stable then
+      -- Snapshot only a clean, unshaken panel. Attack frames reuse this cache
+      -- so the detached HUD stays locked to the physical screen.
+      g.setCanvas(panel)
+      g.clear(0, 0, 0, 0)
+      if g.setShader then g.setShader() end
+      if g.setDepthMode then g.setDepthMode() end
+      if g.setScissor then g.setScissor() end
+      g.setBlendMode("alpha", "premultiplied")
+      g.setColor(1, 1, 1, 1)
+      g.draw(ui, -p.sourceX, -p.sourceY)
+      panelValid = true
+      cachedEnemy = battle.enemy
+    end
+
+    -- Remove the native low copy at the exact position WideBattle.shaken()
+    -- used this frame.  The cached detached panel itself does not move.
+    g.setCanvas(ui)
+    if g.setShader then g.setShader() end
+    if g.setDepthMode then g.setDepthMode() end
+    if g.setScissor then g.setScissor() end
+    g.setBlendMode("replace")
+    g.setColor(0, 0, 0, 0)
+    g.rectangle("fill", p.clearX, p.clearY, ENEMY_W, ENEMY_H)
+
+    -- Preserve WideBattle's full-screen white flash over the cleared source
+    -- rectangle; otherwise removing the low HUD would leave an unflashed hole.
+    local fx = battle.fx
+    if fx and (tonumber(fx.flash or 0) or 0) > 0
+        and ((tonumber(battle.frame or 0) or 0) % 4) < 2 then
+      g.setColor(1, 1, 1, 0.85)
+      g.rectangle("fill", p.clearX, p.clearY, ENEMY_W, ENEMY_H)
+    end
+
+    -- The voxel world override is a dpiscale=1 full-resolution surface, so
+    -- Renderer.frameRects().Up is directly the framebuffer-pixel scale needed
+    -- for one native WIDE pixel.
+    g.setCanvas(world)
+    if g.setShader then g.setShader() end
+    if g.setDepthMode then g.setDepthMode() end
+    if g.setScissor then g.setScissor() end
+    g.setBlendMode("alpha", "premultiplied")
+    g.setColor(1, 1, 1, 1)
+    g.draw(panel, p.targetX, p.targetY, 0, p.scale, p.scale)
+  end)
+  restoreGraphics(g, saved)
+
+  if not ok then
+    local log = V and V.log
+    if log and log.warn then
+      log:warn("[DRAMALESS_SHAPE] enemy HUD relocation failed: %s", tostring(err))
+    end
+    return false
+  end
+  return true
+end
+
+function HUD.install()
+  local Renderer = require("src.render.Renderer")
+  if Renderer.endFrame == installedEndFrame then return true end
+  if not Renderer.dramalessEnemyHudFinalBase then
+    Renderer.dramalessEnemyHudFinalBase = Renderer.endFrame
+  end
+  local base = Renderer.dramalessEnemyHudFinalBase
+  installedEndFrame = function(renderer, ...)
+    local state = renderer.dramalessEnemyHudState
+    local battle = state and state.battle
+    if battle then relocate(renderer, battle) end
+    return base(renderer, ...)
+  end
+  Renderer.endFrame = installedEndFrame
+  return true
+end
+
+function HUD.begin(battle)
+  HUD.install()
+  panelValid = false
+  cachedEnemy = nil
+  local renderer = battle and battle.game and battle.game.renderer
+  if activeRenderer and activeRenderer ~= renderer then
+    activeRenderer.dramalessEnemyHudState = nil
+  end
+  activeRenderer = renderer
+  if renderer then renderer.dramalessEnemyHudState = { battle = battle } end
+end
+
+function HUD.finish()
+  if activeRenderer then activeRenderer.dramalessEnemyHudState = nil end
+  activeRenderer = nil
+  panelValid = false
+  cachedEnemy = nil
+end
+
+function HUD.invalidate()
+  if panelCanvas and panelCanvas.release then pcall(panelCanvas.release, panelCanvas) end
+  panelCanvas = nil
+  panelValid = false
+  cachedEnemy = nil
+end
+
+return HUD
